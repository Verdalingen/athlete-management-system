# === SECRETS & CREDENTIALS ===
.env
.env.*
!.env.example
*.pem
*.key

# === PERSONAL TRAINING DATA & AI OUTPUTS ===
# These are generated at runtime and contain personal health data.
# Use `data/storage/` to persist plans between sessions — it is also excluded.
data/

# === PERSONAL CONFIG (contains email, personal goals) ===
# Copy cli/coach_config_template.yaml and rename it to create your own.
my_training_config.yaml

