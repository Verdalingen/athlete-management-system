# === SECRETS & CREDENTIALS ===
.env
.env.*
!.env.example
*.pem
*.key

# === PERSONAL TRAINING DATA & AI OUTPUTS ===
# These are generated at runtime and contain personal health data.
# Use `data/storage/` to persist plans between sessions — it is also excluded.
data/

# === PERSONAL CONFIG (contains email, personal goals) ===
# Copy cli/coach_config_template.yaml and rename it to create your own.
my_training_config.yaml

# === PYTHON ===
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# === PIXI ENVIRONMENTS ===
.pixi/*
!.pixi/config.toml

# === MACOS ===
.DS_Store
.AppleDouble
.LSOverride

# === EDITORS ===
.vscode/
.idea/
*.swp
*.swo

# === CLAUDE CODE ===
# Local settings/session state stay ignored, but the point-skill backlog and the repo-local copy
# of the `point` skill (needed for GitHub Actions to see it) are meant to be committed and
# reviewed like any other change - see the `point` skill's references/workflow.md.
.claude/*
!.claude/backlog/
!.claude/backlog/**
!.claude/skills/
!.claude/skills/**

# Coverage artifacts
.coverage
htmlcov/
