<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Unique identifier for this agent -->
  <key>Label</key>
  <string>com.ams.sync-kpis</string>

  <!-- Run the sync script via bash (launchd ignores shebangs) -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-l</string>
    <string>/Users/adrianwalderhaug-johnsen/Documents/athlete-management-system/scripts/sync_kpis.sh</string>
  </array>

  <!-- Fire once on login/load -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Fire every 30 minutes as a trigger opportunity. The CLI's internal
       KPI_SYNC_MIN_INTERVAL (2h) is the actual authority on whether work happens —
       this just needs to fire more often than that so a sync isn't missed for long
       after the minimum interval elapses. Cheap no-op (stamp-file check only) when
       skipped. -->
  <key>StartInterval</key>
  <integer>1800</integer>

  <!-- Write stdout/stderr to log files for debugging -->
  <key>StandardOutPath</key>
  <string>/Users/adrianwalderhaug-johnsen/.ams-kpi-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/adrianwalderhaug-johnsen/.ams-kpi-sync.log</string>

  <!-- Keep environment clean -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>/Users/adrianwalderhaug-johnsen</string>
  </dict>
</dict>
</plist>
