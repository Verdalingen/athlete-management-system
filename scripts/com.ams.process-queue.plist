<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Unique identifier for this agent -->
  <key>Label</key>
  <string>com.ams.process-queue</string>

  <!-- Run the queue-processing script via bash (launchd ignores shebangs) -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-l</string>
    <string>/Users/adrianwalderhaug-johnsen/Documents/athlete-management-system/scripts/process_queue.sh</string>
  </array>

  <!-- Fire once on login/load, so an already-queued job gets picked up immediately -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Then poll every 90 seconds — cheap no-op when the queue is empty -->
  <key>StartInterval</key>
  <integer>90</integer>

  <!-- Write stdout/stderr to log files for debugging -->
  <key>StandardOutPath</key>
  <string>/Users/adrianwalderhaug-johnsen/.ams-process-queue.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/adrianwalderhaug-johnsen/.ams-process-queue.log</string>

  <!-- Keep environment clean -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>/Users/adrianwalderhaug-johnsen</string>
  </dict>
</dict>
</plist>
