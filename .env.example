# Copy this file to .env and fill in your values.

# Primary: Anthropic direct (cheaper, no markup, recommended)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Fallback / experimental models (DeepSeek, Gemini, Grok via OpenRouter)
# Also used for Claude if ANTHROPIC_API_KEY is not set.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: OpenAI direct (only needed for pro mode)
# OPENAI_API_KEY=sk-...

# Supabase (CLI / services)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...       # server/CLI only — bypasses RLS
SUPABASE_USER_ID=                             # your UUID from Supabase Auth → Users

# Supabase (web app — add these to web/.env.local)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...        # safe to expose in browser
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...     # server-side only
# SUPABASE_USER_ID=                           # remove after auth is wired up

# Optional, development only: render the app with the fictional demo athlete
# from supabase/seed_demo.sql instead of your own data. Ignored in production
# builds. You still have to be signed in — this overrides the data source, not
# authentication.
# DEMO_USER_ID=00000000-0000-4000-8000-000000000001
