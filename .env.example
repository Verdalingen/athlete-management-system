# Copy this file to .env and fill in your values.

ANTHROPIC_API_KEY=sk-ant-api03-...

# Every node is assigned a tier in services/ai/ai_settings.py: fast (summarise,
# format), reasoning (experts, planners), deep (the season planner). Each tier
# has a default model; override one here. Valid names are the keys of
# ModelSelector.CONFIGURATIONS in services/ai/model_config.py.
#
# Defaults — Haiku / Sonnet / Opus. Opus is 2.5x Sonnet per token but only
# the season planner uses it, and that runs once a season, not on re-plans.
# MODEL_FAST=claude-haiku
# MODEL_REASONING=claude-sonnet
# MODEL_DEEP=claude-opus
#
# Sonnet for the season planner too:
# MODEL_DEEP=claude-sonnet
#
# Cheapest run that still exercises every node — for checking a prompt change,
# not for a plan you will train from (the experts are the analysis):
# MODEL_REASONING=claude-haiku
# MODEL_DEEP=claude-sonnet

# Supabase (CLI / services)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...       # server/CLI only — bypasses RLS
SUPABASE_USER_ID=                             # your UUID from Supabase Auth → Users

# Direct Postgres connection — only used by `pixi run setup-db` to apply the
# migrations in supabase/migrations/ in one shot. Dashboard -> Project
# Settings -> Database -> Connection string -> URI. Use the direct connection
# (port 5432), not the transaction pooler — DDL needs a normal session.
# Not read by the app or the CLI; safe to leave unset once the schema exists.
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# Supabase (web app — add these to web/.env.local)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...        # safe to expose in browser
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...     # server-side only
# SUPABASE_USER_ID=                           # remove after auth is wired up

# Optional, development only: render the app with the fictional demo athlete
# from supabase/seed_demo.sql instead of your own data. Ignored in production
# builds. You still have to be signed in — this overrides the data source, not
# authentication.
# DEMO_USER_ID=00000000-0000-4000-8000-000000000001
